+// Match the relaxed integer-dot lane grouping with standard SIMD instructions.
+// Both variants then accumulate floating-point block scales in the same order.
+#if defined(__wasm_simd128__) && !defined(__wasm_relaxed_simd__)
+static inline v128_t ggml_wasm_portable_dot(v128_t a, v128_t b, v128_t acc) {
+    const v128_t lo = wasm_i32x4_dot_i16x8(wasm_i16x8_extend_low_i8x16(a),
+                                         wasm_i16x8_extend_low_i8x16(b));
+    const v128_t hi = wasm_i32x4_dot_i16x8(wasm_i16x8_extend_high_i8x16(a),
+                                         wasm_i16x8_extend_high_i8x16(b));
+    // Sum adjacent pairs: lanes cover bytes 0..3, 4..7, 8..11, 12..15.
+    const v128_t even = wasm_i32x4_shuffle(lo, hi, 0, 2, 4, 6);
+    const v128_t odd  = wasm_i32x4_shuffle(lo, hi, 1, 3, 5, 7);
+    return wasm_i32x4_add(acc, wasm_i32x4_add(even, odd));
+}
+#define wasm_i32x4_relaxed_dot_i8x16_i7x16_add ggml_wasm_portable_dot
+#endif
+
 
