{
  "manifest_version": 3,
  "name": "Glosside",
  "version": "0.1.7",
  "minimum_chrome_version": "151",
  "description": "__MSG_extensionDescription__",
  "default_locale": "en",
  "permissions": [
    "activeTab",
    "scripting",
    "contextMenus",
    "sidePanel",
    "offscreen",
    "storage",
    "unlimitedStorage",
    "debugger"
  ],
  "optional_host_permissions": [
    "https://*/*",
    "http://*/*"
  ],
  "background": {
    "service_worker": "background/service-worker.js",
    "type": "module"
  },
  "action": {
    "default_title": "Glosside \u2014 \u7ffb\u8a33\u3068\u8a2d\u5b9a",
    "default_popup": "popup/index.html"
  },
  "side_panel": {
    "default_path": "sidepanel/index.html"
  },
  "options_ui": {
    "page": "options/index.html",
    "open_in_tab": true
  },
  "commands": {
    "translate-selection": {
      "suggested_key": {
        "default": "Alt+Shift+T"
      },
      "description": "\u9078\u629e\u3057\u305f\u6587\u5b57\u5217\u3092\u7ffb\u8a33"
    }
  },
  "content_security_policy": {
    "extension_pages": "script-src 'self' 'wasm-unsafe-eval'; object-src 'none'; worker-src 'self'; base-uri 'none'; connect-src 'self' blob: https: http:; img-src 'self' blob: data:; font-src 'self' data:;"
  },
  "cross_origin_embedder_policy": {
    "value": "require-corp"
  },
  "cross_origin_opener_policy": {
    "value": "same-origin"
  },
  "incognito": "split",
  "icons": {
    "16": "icons/16.png",
    "32": "icons/32.png",
    "48": "icons/48.png",
    "128": "icons/128.png"
  }
}
