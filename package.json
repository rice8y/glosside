    "package": "npm run typecheck && node scripts/build.mjs --release && node scripts/package.mjs"
  },
  "dependencies": {
    "@wllama/wllama": "3.8.1",
    "hash-wasm": "4.12.0",
    "pdfjs-dist": "6.5.438"
  },
  "devDependencies": {
    "@types/chrome": "0.3.7",
    "@types/node": "26.6.6",
    "esbuild": "0.28.2",
    "marked": "18.1.3",
    "prettier": "3.9.10",
    "typescript": "7.0.2"
  },
  "license": "MIT",
  "author": "Eito Yoneyama",
  "repository": {
    "type": "git",
    "url": "https://github.com/rice8y/glosside.git"
  }
}
